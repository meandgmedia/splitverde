---
import Base from '../layouts/Base.astro';
---
<Base title="SplitVerde | Insurance Commission Reconciliation Software">
<section class="mx-auto max-w-6xl px-6 py-24 text-center">
<p class="mb-5 font-semibold uppercase tracking-widest text-emerald-700">Insurance commission management</p>
<h1 class="mx-auto max-w-4xl text-5xl font-extrabold tracking-tight text-emerald-950 md:text-7xl">Every commission.<br/><span class="text-emerald-600">Accounted for.</span></h1>
<p class="mx-auto mt-7 max-w-2xl text-xl leading-relaxed text-slate-600">Track carrier commissions, catch payment discrepancies, and manage producer payouts — without the spreadsheets.</p>
<div class="mt-10 flex justify-center gap-4"><a class="rounded-xl bg-emerald-700 px-7 py-4 font-semibold text-white" href="/how-it-works">See how it works</a><a class="rounded-xl border border-emerald-700 px-7 py-4 font-semibold text-emerald-800" href="/pricing">View pricing</a></div>
</section>
<section class="mx-auto grid max-w-6xl gap-6 px-6 md:grid-cols-3">
{[{title:'Import statements',body:'Bring your carrier commission files into one organized workspace.'},{title:'Find discrepancies',body:'Compare expected earnings against carrier payments.'},{title:'Manage producers',body:'Plan and track compensation splits across your agency.'}].map(item => <article class="rounded-2xl border border-slate-200 bg-white p-8"><h2 class="text-xl font-bold text-emerald-950">{item.title}</h2><p class="mt-3 text-slate-600">{item.body}</p></article>)}
</section>
</Base>