---
import Base from '../layouts/Base.astro';
---
<Base title="Verify email | SplitVerde">
<section class="mx-auto max-w-md px-6 py-14"><h1 class="text-3xl font-bold text-emerald-950">Check your email</h1><p class="mt-3 text-slate-600">Enter the six-digit code we sent. It expires in 10 minutes.</p>
<form class="mt-7 rounded-xl border bg-white p-5" method="POST" action="/auth/email/verify">
<label class="block text-sm font-semibold" for="email">Email address</label><input id="email" name="email" type="email" required maxlength="254" autocomplete="email" class="mt-2 w-full rounded-lg border p-3" />
<label class="mt-5 block text-sm font-semibold" for="code">Verification code</label><input id="code" name="code" inputmode="numeric" pattern="[0-9]{6}" required maxlength="6" autocomplete="one-time-code" class="mt-2 w-full rounded-lg border p-3" />
<button type="submit" class="mt-5 w-full rounded-lg bg-emerald-700 px-5 py-3 font-semibold text-white">Verify and sign in</button>
</form><p class="mt-5 text-sm text-slate-500">Codes can only be used once. <a class="underline" href="/login">Request a new code</a>.</p></section>
</Base>
