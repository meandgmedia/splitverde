---
import Base from '../layouts/Base.astro';
const error = Astro.url.searchParams.get('error');
---
<Base title="Sign in | SplitVerde">
<section class="mx-auto max-w-md px-6 py-14">
<h1 class="text-3xl font-bold text-emerald-950">Sign in to SplitVerde</h1>
<p class="mt-3 text-slate-600">Access your private agency workspace.</p>
{error && <p role="alert" class="mt-5 rounded-lg bg-red-50 p-3 text-red-800">Sign-in failed or expired. Please try again.</p>}
<a class="mt-8 block rounded-lg border bg-white px-5 py-3 text-center font-semibold hover:bg-slate-50" href="/auth/google/start">Continue with Google</a>
<div class="my-6 text-center text-sm text-slate-500">or use your email</div>
<form method="POST" action="/auth/email/request" class="rounded-xl border bg-white p-5">
<label class="block text-sm font-semibold" for="email">Email address</label>
<input id="email" name="email" type="email" required autocomplete="email" maxlength="254" class="mt-2 w-full rounded-lg border p-3" placeholder="you@agency.com"/>
<button class="mt-4 w-full rounded-lg bg-emerald-700 px-5 py-3 font-semibold text-white" type="submit">Send verification code</button>
</form>
<p class="mt-5 text-sm text-slate-500">We never ask for a password. A verified email is required to create an account.</p>
</section>
</Base>
